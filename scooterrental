package hackathon;

import java.io.*;
import java.util.*;

class Rental {

    private int rentalID;
    private String customerName;
    private String vehicleModel;
    protected int days;
    private double dailyRate;
    private int lateHours;
    protected String vehicle;

    static final double SECURITY_DEPOSIT = 2000;
    static final double LATE_PENALTY_PER_HOUR = 50;
    static final int WEEKLY_DAYS_COUNT = 7;
    static final double DISCOUNT_PERCENT = 15;

    static Scanner SC = new Scanner(System.in);

    // ---------- safe input helpers (read whole lines, re-prompt on bad input) ----------

    static int readInt(String prompt, int min, int max) {
        while (true) {
            System.out.print(prompt);
            try {
                int v = Integer.parseInt(SC.nextLine().trim());
                if (v < min || v > max) {
                    System.out.println("Value must be between " + min + " and " + max + ".");
                    continue;
                }
                return v;
            } catch (NumberFormatException e) {
                System.out.println("Please enter a valid whole number.");
            }
        }
    }

    static double readDouble(String prompt, double min) {
        while (true) {
            System.out.print(prompt);
            try {
                double v = Double.parseDouble(SC.nextLine().trim());
                if (v < min) {
                    System.out.println("Value must be at least " + min + ".");
                    continue;
                }
                return v;
            } catch (NumberFormatException e) {
                System.out.println("Please enter a valid number.");
            }
        }
    }

    static String readText(String prompt) {
        while (true) {
            System.out.print(prompt);
            String s = SC.nextLine().trim();
            if (!s.isEmpty()) {
                return s;
            }
            System.out.println("Input cannot be empty.");
        }
    }

    // ---------- constructor ----------

    Rental(String vehicle) {

        this.vehicle = vehicle;

        rentalID = readInt("Enter rental ID: ", 1, Integer.MAX_VALUE);
        customerName = readText("Enter customer name: ");

        // vehicle model: re-ask until it is available
        while (true) {
            String model = readText("Enter vehicle model (Honda/Royal/Ola): ");
            try {
                RentRide1.checkVehicleAvailability(model);
                vehicleModel = model;
                break;
            } catch (VehicleNotAvailableException e) {
                System.out.println("ERROR: " + e.getMessage());
            }
        }

        // days: re-ask until valid
        while (true) {
            int d = readInt("Enter number of days: ", Integer.MIN_VALUE, Integer.MAX_VALUE);
            try {
                RentRide1.validateDays(d);
                days = d;
                break;
            } catch (InvalidDaysException e) {
                System.out.println("ERROR: " + e.getMessage());
            }
        }

        dailyRate = readDouble("Enter daily rate: ", 0);

        if (days >= WEEKLY_DAYS_COUNT) {
            System.out.println(DISCOUNT_PERCENT + "% discount applicable");
        } else {
            System.out.println("0% discount");
        }

        lateHours = readInt("Enter late hours (0 if not applicable): ", 0, Integer.MAX_VALUE);
    }

    // ---------- setters ----------

    void setID(int id) { this.rentalID = id; }
    void setName(String n) { this.customerName = n; }
    void setVehicleModel(String vm) { this.vehicleModel = vm; }
    void setDays(int d) { this.days = d; }
    void setDailyRate(double dr) { this.dailyRate = dr; }

    // ---------- getters ----------

    int getID() { return rentalID; }
    String getName() { return customerName; }
    String getModel() { return vehicleModel; }
    int getDays() { return days; }
    double getDailyRate() { return dailyRate; }
    int getLateHours() { return lateHours; }
    String getVehicle() { return vehicle; }

    // ---------- calculations ----------

    double calculateRent() {

        double rent = dailyRate * days;

        if (days >= WEEKLY_DAYS_COUNT) {
            rent = rent - (rent * DISCOUNT_PERCENT / 100);
        }

        return rent;
    }

    double calculateLatePenalty(int l) {

        if (l > 0) {
            return l * LATE_PENALTY_PER_HOUR;
        }

        return 0;
    }

    // extra penalties added by subclasses (e.g. battery penalty)
    double calculateExtraPenalty() {
        return 0;
    }

    double calculateTotalCharges() {
        return calculateRent()
                + calculateLatePenalty(lateHours)
                + calculateExtraPenalty();
    }

    // money returned to customer from the deposit
    double calculateRefund() {
        return Math.max(0, SECURITY_DEPOSIT - calculateTotalCharges());
    }

    // money the customer still owes if charges exceed the deposit
    double calculateBalanceDue() {
        return Math.max(0, calculateTotalCharges() - SECURITY_DEPOSIT);
    }

    void compare(Rental r) {

        double mine = this.calculateRent();
        double theirs = r.calculateRent();

        if (mine > theirs) {
            System.out.println(this.vehicleModel
                    + " is expensive compared to " + r.vehicleModel);
        } else if (mine < theirs) {
            System.out.println(r.vehicleModel
                    + " is expensive compared to " + this.vehicleModel);
        } else {
            System.out.println("Both vehicles have the same rental cost.");
        }
    }

    void display() {

        System.out.println("\n------ RENTAL DETAILS ------");

        System.out.println("Rental ID: " + rentalID);
        System.out.println("Customer Name: " + customerName);
        System.out.println("Vehicle Model: " + vehicleModel);
        System.out.println("Vehicle Type: " + vehicle);
        System.out.println("Days: " + days);
        System.out.println("Daily Rate: " + dailyRate);
        System.out.println("Late Hours: " + lateHours);
        System.out.println("Late Penalty: " + calculateLatePenalty(lateHours));
        System.out.println("Rent Fee: " + calculateRent());
    }

    // totals are printed last so subclasses can add their lines first
    void displayTotals() {

        System.out.println("Total Charges: " + calculateTotalCharges());
        System.out.println("Refund Money: " + calculateRefund());

        if (calculateBalanceDue() > 0) {
            System.out.println("Amount Due From Customer: " + calculateBalanceDue());
        }
    }
}


class ScooterRental extends Rental {

    private double chargingFeePerDay;
    private int batteryPercentOnReturn;

    ScooterRental(String v) {

        super(v);

        chargingFeePerDay = readDouble("Enter charging fee per day: ", 0);
        batteryPercentOnReturn = readInt("Enter battery percentage on return (0-100): ", 0, 100);
    }

    int calculateBatteryPenalty() {

        if (batteryPercentOnReturn <= 20) {
            return 100;
        }

        return 0;
    }

    double calculateChargingFee() {
        return days * chargingFeePerDay;
    }

    @Override
    double calculateRent() {
        return super.calculateRent() + calculateChargingFee();
    }

    @Override
    double calculateExtraPenalty() {
        return calculateBatteryPenalty();
    }

    @Override
    void display() {

        super.display();

        System.out.println("Charging Fee Per Day: " + chargingFeePerDay);
        System.out.println("Battery Percentage on Return: " + batteryPercentOnReturn);
        System.out.println("Charging Fee: " + calculateChargingFee());
        System.out.println("Battery Penalty: " + calculateBatteryPenalty());
    }
}


// USER DEFINED EXCEPTIONS

class VehicleNotAvailableException extends Exception {
    VehicleNotAvailableException(String m) { super(m); }
}

class InvalidDaysException extends Exception {
    InvalidDaysException(String m) { super(m); }
}

class RentalNotFoundException extends Exception {
    RentalNotFoundException(String m) { super(m); }
}


public class RentRide1 {

    static final String FILE_NAME = "Rental.txt";

    public static void main(String[] args) {

        String vehicle = Rental.readText("Enter if the vehicle is electric or normal: ");

        System.out.println("\n--- Rental 1 ---");
        Rental R1 = vehicle.equalsIgnoreCase("electric")
                ? new ScooterRental(vehicle)
                : new Rental(vehicle);

        System.out.println("\n--- Rental 2 (electric) ---");
        ScooterRental SR1 = new ScooterRental("electric");

        if (R1.getID() == SR1.getID()) {
            System.out.println("WARNING: both rentals share the same ID; search will return only the first.");
        }

        ArrayList<Rental> rentals = new ArrayList<>();
        rentals.add(R1);
        rentals.add(SR1);

        try {

            // WRITE AND READ FILE
            writeFile(R1);
            writeFile(SR1);
            readFile();

            // DISPLAY RENTAL DETAILS
            displayAll(R1);
            displayAll(SR1);

            // SEARCH RENTAL USING ID
            int id = Rental.readInt("\nEnter Rental ID to search: ", Integer.MIN_VALUE, Integer.MAX_VALUE);
            Rental found = searchRental(rentals, id);

            System.out.println("\nRental Found Successfully!");
            displayAll(found);

            // COMPARE RENTAL COSTS
            System.out.println("\n------ RENTAL COMPARISON ------");
            R1.compare(SR1);

        } catch (RentalNotFoundException e) {
            System.out.println("ERROR: " + e.getMessage());
        } catch (IOException e) {
            System.out.println("FILE ERROR: " + e.getMessage());
        }

        Rental.SC.close();
    }


    // VEHICLE AVAILABILITY CHECK (case-insensitive)

    static void checkVehicleAvailability(String model)
            throws VehicleNotAvailableException {

        String[] availableVehicles = {"Honda", "Royal", "Ola"};

        for (String s : availableVehicles) {
            if (s.equalsIgnoreCase(model)) {
                return;
            }
        }

        throw new VehicleNotAvailableException(
                "Vehicle " + model + " is not available for rental!");
    }


    // FILE WRITING

    static void writeFile(Rental r) throws IOException {

        try (FileWriter fw = new FileWriter(FILE_NAME, true)) {
            fw.write(r.getID() + "|" +
                    r.getName() + "|" +
                    r.getModel() + "|" +
                    r.getVehicle() + "|" +
                    r.getDays() + "|" +
                    r.getDailyRate() + "|" +
                    r.getLateHours() + "\n");
        }

        System.out.println("Rental record saved successfully!");
    }


    // FILE READING

    static void readFile() {

        System.out.println("\n------ RENTAL FILE RECORDS ------");

        try (BufferedReader br = new BufferedReader(new FileReader(FILE_NAME))) {

            String data;

            while ((data = br.readLine()) != null) {

                String[] arr = data.split("\\|");

                if (arr.length < 7) {
                    // record from an older run with a different format
                    System.out.println("Old-format record: " + data);
                } else {
                    System.out.println("Rental ID: " + arr[0]);
                    System.out.println("Customer Name: " + arr[1]);
                    System.out.println("Vehicle Model: " + arr[2]);
                    System.out.println("Vehicle Type: " + arr[3]);
                    System.out.println("Days: " + arr[4]);
                    System.out.println("Daily Rate: " + arr[5]);
                    System.out.println("Late Hours: " + arr[6]);
                }

                System.out.println("--------------------------");
            }

        } catch (IOException e) {
            System.out.println("File reading error: " + e.getMessage());
        } finally {
            System.out.println("FILE READING COMPLETED");
        }
    }


    // DISPLAY A RENTAL (details + totals)

    static void displayAll(Rental r) {
        r.display();
        r.displayTotals();
    }


    // VALIDATE RENTAL DAYS

    static void validateDays(int days) throws InvalidDaysException {

        if (days <= 0) {
            throw new InvalidDaysException(
                    "Invalid rental duration! Days must be greater than zero.");
        }
    }


    // SEARCH RENTAL USING ARRAYLIST

    static Rental searchRental(ArrayList<Rental> rentals, int id)
            throws RentalNotFoundException {

        for (Rental r : rentals) {
            if (r.getID() == id) {
                return r;
            }
        }

        throw new RentalNotFoundException("Rental ID " + id + " not found!");
    }
}
